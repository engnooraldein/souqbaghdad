{
    "name": "workspace",
    "version": "0.0.0",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "npm run dev --workspace=@workspace/souq-baghdad",
        "build": "npm run build --workspace=@workspace/souq-baghdad",
        "typecheck:libs": "tsc --build",
        "typecheck": "npm run typecheck --workspaces --if-present"
    },
    "workspaces": [
        "artifacts/*",
        "lib/*",
        "scripts"
    ],
    "private": true,
    "devDependencies": {
        "@types/node": "^26.3.0",
        "prettier": "^3.8.3",
        "typescript": "~5.9.3",
        "vite": "^7.3.2"
    },
    "packageManager": "pnpm@9.1.0"
}
